{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshield.dev/schemas/policy-bundle-v1.json",
  "title": "AgentShield policy bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policies"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "enabled",
        "scope",
        "policy_decision",
        "requested_action",
        "priority",
        "severity",
        "conditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "policy_decision": {
          "enum": ["observe", "allow", "deny"]
        },
        "requested_action": {
          "oneOf": [
            {
              "enum": ["audit", "alert", "block", "contain"]
            },
            {
              "const": "kill",
              "deprecated": true
            }
          ]
        },
        "priority": {
          "type": "integer"
        },
        "severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy_decision": {
                "const": "observe"
              }
            }
          },
          "then": {
            "properties": {
              "requested_action": {
                "enum": ["audit", "alert"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy_decision": {
                "const": "allow"
              }
            }
          },
          "then": {
            "properties": {
              "requested_action": {
                "const": "audit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy_decision": {
                "const": "deny"
              }
            }
          },
          "then": {
            "properties": {
              "requested_action": {
                "enum": ["audit", "alert", "block", "contain", "kill"]
              }
            }
          }
        }
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "global"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "run_id"],
          "properties": {
            "type": {
              "const": "run"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cgroup_id"],
          "properties": {
            "type": {
              "const": "cgroup"
            },
            "cgroup_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label_selector"],
          "properties": {
            "type": {
              "const": "labels"
            },
            "label_selector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/file_condition"
        },
        "exec": {
          "$ref": "#/$defs/exec_condition"
        },
        "network": {
          "$ref": "#/$defs/network_condition"
        }
      },
      "oneOf": [
        {
          "required": ["file"]
        },
        {
          "required": ["exec"]
        },
        {
          "required": ["network"]
        }
      ]
    },
    "file_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access"],
      "properties": {
        "exact_paths": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "prefixes": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "suffixes": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "basenames": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "access": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["read", "write", "execute"]
          }
        }
      },
      "anyOf": [
        {
          "required": ["exact_paths"]
        },
        {
          "required": ["prefixes"]
        },
        {
          "required": ["suffixes"]
        },
        {
          "required": ["basenames"]
        }
      ]
    },
    "exec_condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executables": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "arg_contains": {
          "$ref": "#/$defs/non_empty_strings"
        }
      },
      "anyOf": [
        {
          "required": ["executables"]
        },
        {
          "required": ["arg_contains"]
        }
      ]
    },
    "network_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "families"],
      "properties": {
        "default": {
          "enum": ["default_observe", "default_deny"]
        },
        "cidrs": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port_range"
          }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ipv4", "ipv6"]
          }
        }
      }
    },
    "port_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "to": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
